DENOVA_HOST_PORT=8080
DENOVA_REMOTE_ACCESS_USERNAME=denova
DENOVA_REMOTE_ACCESS_PASSWORD=replace-with-a-long-random-password
# Optional: bind one project at startup. Leave empty to use the project picker.
DENOVA_WORKSPACE=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro

OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional SearXNG instance used by the Web Search tool.
DENOVA_SEARXNG_BASE_URL=
